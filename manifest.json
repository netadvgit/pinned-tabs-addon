{
  "manifest_version": 2,
  "name": "Persistent Pinned Tabs",
  "version": "1.3.0",
  "description": "Pinned tabs that survive restarts, follow you into every window and sync between browsers through your own Dropbox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "persistent-pinned-tabs@netadev.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "identity",
    "alarms",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Pinned Tabs settings",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}